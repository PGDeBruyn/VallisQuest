[node name="DialogueText" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "[wave]Woah[/wave], another traveler! What are you doing here?"
npcInfo = ExtResource("5_suo37")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"

[node name="DialogueText2" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "I'm helping someone look for their brother. Are you Quinto, by chance?"
npcInfo = ExtResource("6_7xb3f")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"

[node name="DialogueText3" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "Yes! I am! Did Andross get worried again?"
npcInfo = ExtResource("5_suo37")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"

[node name="DialogueText4" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "I believe he did. I'm glad you are safe! He'll be happy to know that nothing bad happened."
npcInfo = ExtResource("6_7xb3f")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"

[node name="DialogueText5" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "Yeah, I'm sure he has been worrying nonstop since I entered this place."
npcInfo = ExtResource("5_suo37")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"

[node name="DialogueText6" type="Node" parent="Npc/DialogueInteraction"]
script = ExtResource("5_j381n")
text = "I'll go let him know I'm alright once I've finished up what I'm doing here."
npcInfo = ExtResource("5_suo37")
metadata/_custom_type_script = "uid://yi8cvfh3wtvw"
